rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Helper functions ==========
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isMember(orgId) {
      return isAuthenticated()
        && orgId != null
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function memberRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function isOrgAdmin(orgId) {
      return isMember(orgId) && (memberRole(orgId) == 'owner' || memberRole(orgId) == 'coordinator');
    }

    function isOrgOwner(orgId) {
      return isMember(orgId) && memberRole(orgId) == 'owner';
    }

    function canReadPlanning(planning) {
      return isOwner(planning.userId)
        || isAdmin()
        || (planning.orgId != null && isMember(planning.orgId));
    }

    // ========== Users: solo propio perfil ==========
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ========== Organizations ==========
    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if false; // solo desde Cloud Functions (createOrganization)
      allow update: if isOrgAdmin(orgId);
      allow delete: if isOrgOwner(orgId);

      // Members: cualquier miembro lee, escritura solo desde Cloud Functions
      // (inviteMember/acceptInvite/removeMember validan roles en el backend).
      match /members/{uid} {
        allow read: if isMember(orgId);
        allow write: if false;
      }

      // Invitations: solo admin de la org lee/escribe
      match /invitations/{inviteId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false; // solo desde Cloud Functions
      }
    }

    // ========== Plannings: propietario, admin, o miembro de la org ==========
    match /plannings/{planningId} {
      allow read: if canReadPlanning(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.orgId == null || isMember(request.resource.data.orgId));
      allow update: if isOwner(resource.data.userId) || isAdmin() || isOrgAdmin(resource.data.orgId);
      allow delete: if isOwner(resource.data.userId) || isAdmin() || isOrgAdmin(resource.data.orgId);

      // Subcolección de versiones
      match /versions/{versionId} {
        allow read: if canReadPlanning(get(/databases/$(database)/documents/plannings/$(planningId)).data);
        allow write: if isOwner(get(/databases/$(database)/documents/plannings/$(planningId)).data.userId) || isAdmin();
      }

      // Comentarios: leen quienes pueden leer la planificación, escriben miembros de la org
      match /comments/{commentId} {
        allow read: if canReadPlanning(get(/databases/$(database)/documents/plannings/$(planningId)).data);
        allow create: if canReadPlanning(get(/databases/$(database)/documents/plannings/$(planningId)).data)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.planningId == planningId;
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // ========== Curriculum: lectura pública, escritura solo admin ==========
    match /curriculum/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== Catalog (asignaturas, niveles): lectura pública, escritura solo admin ==========
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== Prompt templates: solo admin ==========
    match /prompt-templates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ========== Catálogo metodológico (U2): lectura pública, escritura solo admin ==========
    match /methodology-catalog/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== Recomendaciones metodológicas (U4): propietario ==========
    match /methodology-recommendations/{recommendationId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.uid);
    }

    // ========== Feature flags (U3): lectura pública (wizard/cache 5 min), escritura admin ==========
    match /config/feature-flags {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== Recursos del docente (U3): propietario ==========
    match /resource-profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ========== Contexto territorial opcional (U3): propietario ==========
    match /territorial-contexts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ========== Catálogo de especialidades TP (U3): lectura pública, escritura admin ==========
    match /tp-specialties/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== Contexto TP opcional (U3): propietario ==========
    match /tp-contexts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ========== Audit logs: solo Cloud Functions (no acceso directo) ==========
    match /audit-logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // solo desde Cloud Functions
    }

    // ========== AI costs: admin y propietario ==========
    match /ai-costs/{costId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // solo desde Cloud Functions
    }

    // ========== Budget usage: solo Cloud Functions (kill-switch de presupuesto) ==========
    match /budget-usage/{month} {
      allow read: if isAdmin();
      allow write: if false; // solo desde Cloud Functions (recordBudgetUsage)
    }

    // ========== Error logs: crea el propio usuario, solo admin lee ==========
    match /error-logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ========== Feedback: solo admin lee, escritura desde Cloud Functions ==========
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow write: if false; // solo desde Cloud Functions (submitFeedback)
    }

    // ========== Denegar todo lo demás ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
