# PlanificaIA - Variables de Entorno
# Copia este archivo como .env y completa los valores

# DeepSeek API Key (obtener en https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Gemini API Key (fallback de ultimo recurso - es CARA, usar solo si DeepSeek falla)
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Poner false para desactivar el fallback a Gemini por completo
GEMINI_FALLBACK_ENABLED=true

# Firebase
FIREBASE_PROJECT_ID=planificacion-con-ia
FIREBASE_STORAGE_BUCKET=planificacion-con-ia.firebasestorage.app
